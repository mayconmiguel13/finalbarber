# MySQL Database connection string
DATABASE_URL="mysql://root:password@127.0.0.1:3306/barber_db"

# 🔑 Google Gemini Flash API Key (Grátis em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Conexão com Evolution API (Docker local na porta 18080)
EVOLUTION_API_URL="http://127.0.0.1:18080"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="barber-ia"
WEBHOOK_URL="http://localhost:3333/api/webhooks/whatsapp"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Asaas API
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY="your-asaas-api-key"

# Port
PORT=3333
NODE_ENV=development
