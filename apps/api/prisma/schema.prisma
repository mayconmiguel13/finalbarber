datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  BARBER
  RECEPTIONIST
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingOrigin {
  WHATSAPP_AI
  PWA_WEB
  COUNTER_WALKIN
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum TransactionStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Organization {
  id                  String       @id @default(uuid())
  name                String       @db.VarChar(120)
  slug                String       @unique @db.VarChar(60) // Para URLs amigáveis: app.barber.com/atelier88
  document            String?      @db.VarChar(20) // CNPJ ou CPF do estabelecimento
  phone               String       @db.VarChar(25) // WhatsApp do salão
  postalCode          String?      @db.VarChar(10)  // CEP
  address             String?      @db.VarChar(255) // Logradouro
  addressNumber       String?      @db.VarChar(20)  // Número
  neighborhood        String?      @db.VarChar(100) // Bairro
  complement          String?      @db.VarChar(100) // Complemento
  city                String?      @db.VarChar(100)
  state               String?      @db.VarChar(2)

  // Configurações Visuais e White-label
  themeColor          String       @default("gold") @db.VarChar(20) // gold, blue, emerald, copper
  themeMode           String       @default("dark") @db.VarChar(10) // dark, light
  logoUrl             String?      @db.VarChar(500)

  // Configuração do Incentivo de Pagamento Online (Anti No-Show)
  onlineDiscountActive Boolean     @default(true)
  onlineDiscountType   DiscountType @default(PERCENTAGE)
  onlineDiscountValue  Decimal     @default(10.00) @db.Decimal(5, 2) // Ex: 10% ou R$ 5,00
  toleranceMinutes     Int         @default(15)

  // Configurações de Recebimento Pix Direto
  pixKey              String?      @db.VarChar(100)
  pixKeyType          String?      @db.VarChar(20)  // CPF, CNPJ, EMAIL, PHONE, RANDOM

  // Horários de Funcionamento (Segunda a Domingo)
  openingHours        Json?

  // Configurações de Subadquirente / Asaas
  asaasWalletId       String?      @db.VarChar(100) // Subconta Asaas da Barbearia

  // SaaS & Plan / Subscription Management (30 Dias Grátis)
  planStatus          String       @default("TRIAL") @db.VarChar(20) // TRIAL, ACTIVE, EXPIRED, PAST_DUE
  planTier            String       @default("PRO") @db.VarChar(20)   // STARTER, PRO, ENTERPRISE
  trialEndsAt         DateTime?
  subscriptionEndsAt  DateTime?
  ownerName           String?      @db.VarChar(120)
  onboardingCompleted Boolean      @default(false)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users               User[]
  barberProfiles      BarberProfile[]
  services            Service[]
  customers           Customer[]
  appointments        Appointment[]
  transactions        Transaction[]
  products            Product[]
  whatsappSessions    WhatsAppSession[]
  galleryItems        GalleryItem[]
  financialEntries    FinancialEntry[]
  productSales        ProductSale[]
  tvAds               TvAd[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid())
  orgId          String
  name           String        @db.VarChar(100)
  email          String        @unique @db.VarChar(120)
  passwordHash   String        @db.VarChar(255)
  phone          String?       @db.VarChar(25)
  avatarUrl      String?       @db.MediumText
  role           Role          @default(BARBER)
  active         Boolean       @default(true)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  barberProfile  BarberProfile?

  @@index([orgId])
  @@map("users")
}

model BarberProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  orgId           String
  nickname        String?       @db.VarChar(60) // Ex: Diego "Fade"
  document        String?       @db.VarChar(20) // CPF / CNPJ MEI para Lei do Salão-Parceiro
  pixKey          String?       @db.VarChar(100)
  asaasAccountId  String?       @db.VarChar(100) // Subconta Asaas do Barbeiro para Split automático
  commissionRate  Decimal       @default(50.00) @db.Decimal(5, 2) // Cota-parte do barbeiro em % (Ex: 50.00%)
  chair           String?       @default("Cadeira Principal") @db.VarChar(50)
  specialties     String?       @db.VarChar(255)
  workingDays     String?       @default("mon,tue,wed,thu,fri,sat") @db.VarChar(100)
  customSchedule  Json?
  bio             String?       @db.Text
  active          Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([orgId])
  @@map("barber_profiles")
}

model Service {
  id              String        @id @default(uuid())
  orgId           String
  name            String        @db.VarChar(100)
  description     String?       @db.Text
  durationMinutes Int           @default(40)
  price           Decimal       @db.Decimal(10, 2)
  category        String?       @default("Cortes") @db.VarChar(50)
  photoUrl        String?       @db.MediumText
  active          Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([orgId])
  @@map("services")
}

model GalleryItem {
  id                String        @id @default(uuid())
  orgId             String
  barberId          String?
  serviceId         String?
  title             String        @db.VarChar(150)
  description       String?       @db.Text
  photoUrl          String        @db.MediumText
  category          String?       @default("Cortes") @db.VarChar(50)
  tags              String?       @db.VarChar(255)
  whatsappAiEnabled Boolean       @default(true)
  likesCount        Int           @default(0)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([barberId])
  @@map("gallery_items")
}

model Customer {
  id              String        @id @default(uuid())
  orgId           String
  name            String        @db.VarChar(100)
  phone           String        @db.VarChar(25) // Identificador chave no WhatsApp (DDI + DDD + Num)
  email           String?       @db.VarChar(120)
  birthDate       String?       @db.VarChar(10)
  instagram       String?       @db.VarChar(50)
  avatarUrl       String?       @db.MediumText
  notes           String?       @db.Text
  preferences     Json?
  isVipMember     Boolean       @default(false) // Clube de Assinatura

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("customers")
}

model Appointment {
  id              String            @id @default(uuid())
  orgId           String
  barberId        String
  customerId      String
  serviceId       String

  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(CONFIRMED)
  origin          BookingOrigin     @default(WHATSAPP_AI)

  // Valores Financeiros
  originalPrice   Decimal           @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0.00) @db.Decimal(10, 2)
  finalPrice      Decimal           @db.Decimal(10, 2)

  notes           String?           @db.Text

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  barber          BarberProfile     @relation(fields: [barberId], references: [id])
  customer        Customer          @relation(fields: [customerId], references: [id])
  service         Service           @relation(fields: [serviceId], references: [id])
  transaction     Transaction?

  @@index([orgId, startsAt])
  @@index([barberId, startsAt])
  @@map("appointments")
}

model Transaction {
  id              String            @id @default(uuid())
  orgId           String
  appointmentId   String            @unique
  externalId      String?           @db.VarChar(100) // ID da cobrança no Asaas
  paymentMethod   PaymentMethod     @default(PIX)
  status          TransactionStatus @default(PENDING)

  // Divisão Inteligente (Split Salão-Parceiro)
  grossAmount     Decimal           @db.Decimal(10, 2) // Valor total pago pelo cliente
  salonShare      Decimal           @db.Decimal(10, 2) // Cota-parte da Barbearia
  barberShare     Decimal           @db.Decimal(10, 2) // Cota-parte do Barbeiro MEI
  platformFee     Decimal           @default(1.49) @db.Decimal(10, 2) // Taxa de intermediação do seu SaaS retida
  gatewayFee      Decimal           @default(0.99) @db.Decimal(10, 2) // Custo de processamento do Asaas

  pixQrCodeUrl    String?           @db.Text
  pixCopiaCola    String?           @db.Text

  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("transactions")
}

model Product {
  id                   String        @id @default(uuid())
  orgId                String
  name                 String        @db.VarChar(100)
  category             String?       @default("Cosméticos") @db.VarChar(60)
  photoUrl             String?       @db.MediumText
  stockQuantity        Int           @default(0)
  minStockAlert        Int           @default(5)
  costPrice            Decimal       @db.Decimal(10, 2)
  salePrice            Decimal       @db.Decimal(10, 2)
  commissionPercentage Decimal       @default(0.00) @db.Decimal(5, 2)
  expirationDate       DateTime?     @db.Date
  batchCode            String?       @db.VarChar(50)
  barcode              String?       @db.VarChar(60)
  description          String?       @db.VarChar(255)
  active               Boolean       @default(true)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("products")
}

model FinancialEntry {
  id               String        @id @default(uuid())
  orgId            String
  type             String        @db.VarChar(15) // 'INCOME' | 'EXPENSE'
  category         String        @db.VarChar(60)
  description      String        @db.VarChar(255)
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    String        @default("PIX") @db.VarChar(30)
  status           String        @default("PAID") @db.VarChar(20)
  barberId         String?       @db.VarChar(36)
  barberCommission Decimal       @default(0.00) @db.Decimal(10, 2)
  paidAt           DateTime?     @default(now())
  dueDate          DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  organization     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([type])
  @@index([barberId])
  @@map("financial_entries")
}

model ProductSale {
  id               String        @id @default(uuid())
  orgId            String
  productId        String        @db.VarChar(36)
  barberId         String?       @db.VarChar(36)
  customerId       String?       @db.VarChar(36)
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  commissionRate   Decimal       @default(0.00) @db.Decimal(5, 2)
  commissionAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentMethod    String        @default("PIX") @db.VarChar(30)
  createdAt        DateTime      @default(now())

  organization     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([barberId])
  @@index([productId])
  @@map("product_sales")
}

model WhatsAppSession {
  id              String        @id @default(uuid())
  orgId           String
  customerPhone   String        @db.VarChar(25)
  conversationContext Json?     // Histórico recente e variáveis de estado da conversa da IA
  lastInteraction DateTime      @default(now())

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, customerPhone])
  @@map("whatsapp_sessions")
}

model WhatsAppSetting {
  id                      String    @id @default("default")
  orgId                   String?
  instanceName            String    @default("barber-ia")
  apiUrl                  String    @default("http://127.0.0.1:18080")
  webhookUrl              String    @default("http://localhost:3333/api/webhooks/whatsapp")
  connectedPhone          String?   @default("+55 11 98765-4321")
  status                  String    @default("CONNECTED")
  deviceModel             String?   @default("iPhone 15 Pro • WhatsApp Business")
  batteryLevel            Int       @default(88)
  isCharging              Boolean   @default(true)
  assistantName           String    @default("Sofia")
  aiModel                 String    @default("gemini-flash-lite-latest")
  aiTone                  String    @default("BARBER_STREET")
  pixDiscountPercent      Int       @default(10)
  maxLateToleranceMinutes Int       @default(15)
  offerComplimentaryBeer  Boolean   @default(true)
  hasFreeParking          Boolean   @default(true)
  customInstructions      String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("whatsapp_settings")
}

model WhatsAppNotification {
  id            String    @id
  key           String    @unique
  title         String    @db.VarChar(120)
  description   String    @db.Text
  enabled       Boolean   @default(true)
  triggerTime   String    @db.VarChar(80)
  template      String    @db.Text
  sentThisMonth Int       @default(0)
  impactMetric  String    @db.VarChar(80)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("whatsapp_notifications")
}

model WhatsAppCampaign {
  id               String    @id
  name             String    @db.VarChar(150)
  segment          String    @db.VarChar(100)
  totalRecipients  Int       @default(0)
  deliveredCount   Int       @default(0)
  repliedCount     Int       @default(0)
  bookingsCount    Int       @default(0)
  revenueGenerated Decimal   @default(0.00) @db.Decimal(10, 2)
  status           String    @default("COMPLETED")
  messageText      String    @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("whatsapp_campaigns")
}


model WhatsAppConversation {
  id              String            @id
  orgId           String?
  customerPhone   String            @db.VarChar(25)
  customerName    String            @db.VarChar(100)
  avatar          String?           @db.VarChar(500)
  unreadCount     Int               @default(0)
  aiActive        Boolean           @default(true)
  status          String            @default("AI_HANDLING")
  lastMessage     String?           @db.Text
  lastMessageTime String?           @db.VarChar(30)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        WhatsAppMessage[]

  @@index([customerPhone])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  sender         String               @db.VarChar(20) // 'client' | 'ai' | 'human'
  text           String               @db.Text
  time           String               @db.VarChar(30)
  isAudio        Boolean              @default(false)
  audioDuration  String?              @db.VarChar(20)
  bookingData    Json?
  pixCopiaCola   String?              @db.Text
  mediaItems     Json?
  createdAt      DateTime             @default(now())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("whatsapp_messages")
}


model TvAd {
  id                 String        @id @default(uuid())
  orgId              String
  title              String        @db.VarChar(120)
  subtitle           String?       @db.VarChar(255)
  category           String        @default("PARTNER") @db.VarChar(50) // PARTNER, PRODUCTS, BAR, NOTICE
  mediaType          String        @default("IMAGE") @db.VarChar(20) // IMAGE, VIDEO
  imageUrl           String        @db.LongText
  videoUrl           String?       @db.LongText
  targetUrl          String?       @db.VarChar(255)
  qrCodeLabel        String?       @db.VarChar(100)
  priceTag           String?       @db.VarChar(50)
  partnerMonthlyFee  Decimal?      @default(0.00) @db.Decimal(10, 2)
  displayDuration    Int           @default(12) // segundos
  active             Boolean       @default(true)
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("tv_ads")
}
